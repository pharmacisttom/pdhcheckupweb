{
  "name": "pdh-smart-healthcheck",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --turbopack --port 3036",
    "build": "prisma generate && next build --webpack",
    "start": "next start --port 3036",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pentest": "node scripts/test-db.mjs && tsx scripts/pentest-http.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "format": "prettier --write src prisma tests docs",
    "test:db": "node scripts/test-db.mjs",
    "api:contract": "tsx scripts/generate-contract.ts",
    "test:unit": "vitest run tests/unit",
    "test:interest:e2e": "playwright test --config playwright.interest.config.ts",
    "test:no-otp:e2e": "playwright test --config playwright.no-otp.config.ts",
    "test:staff:e2e": "playwright test --config playwright.staff.config.ts",
    "staff:expire-invitations": "tsx scripts/staff-invitation-expiry.ts",
    "email:check-domain": "node scripts/check-email-domain.mjs",
    "test:chat:e2e": "playwright test --config playwright.chat.config.ts",
    "chat:retention": "tsx scripts/chat-retention.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.2",
    "nodemailer": "^10.3.1",
    "otpauth": "^9.5.2",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
