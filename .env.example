DATABASE_URL="mysql://pdh_app:CHANGE_ME@127.0.0.1:3306/pdh_healthcheck"
APP_URL="http://localhost:3036"
# Set PORT in the process environment when launching the standalone server.
PORT="3036"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=""
OTP_PEPPER=""
SEED_DEMO="false"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# OTP_PROVIDER=test is accepted only outside production. Codes are never logged.
OTP_PROVIDER="disabled"

# Optional real OTP adapter (server-side only). Test provider is rejected in production.
# OTP_PROVIDER=http
# OTP_HTTP_URL=https://your-approved-sms-gateway.example/otp
# OTP_HTTP_TOKEN=replace-with-provider-token

# Staff email is disabled until sender domain/provider setup is reviewed. Never reuse application passwords.
EMAIL_PROVIDER="disabled"
EMAIL_FROM=""
EMAIL_SENDER_VERIFIED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""
EMAIL_DKIM_SELECTOR=""

# Health Chat: independently disabled until policy and membership are approved.
CHAT_ENABLED="false"
CHAT_AI_ENABLED="false"
CHAT_AI_PROVIDER="disabled"
CHAT_EXTERNAL_PROCESSING_APPROVED="false"
CHAT_AI_MODEL=""
CHAT_AI_API_KEY=""
CHAT_AI_ENDPOINT=""
# Conservative reservation per attempt; not actual reported provider cost.
CHAT_AI_MAX_CALL_USD="0"
